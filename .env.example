# Plantilla de variables de entorno. Copia este fichero a .env y rellena los valores.
# El fichero .env NUNCA se versiona (§12); solo se versiona esta plantilla.

# Clave de API gratuita de abuse.ch para ThreatFox, si la fuente la requiere (§3.2).
# Procedimiento de obtención documentado en el README.
ABUSECH_AUTH_KEY=

# Nivel de logging: DEBUG, INFO, WARNING o ERROR. Si se define, tiene prioridad
# sobre el valor de config/settings.yaml.
LOG_LEVEL=INFO
